# Обов'язково: ключ Gemini (безкоштовний тір достатній). Отримати: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Опційно: запис результату в Google Sheet.
# GOOGLE_SHEETS_ID — id таблиці з її URL (docs.google.com/spreadsheets/d/<ЦЕЙ_ID>/edit)
# GOOGLE_SERVICE_ACCOUNT_JSON — шлях до JSON-ключа сервісного акаунту з доступом
#   "Editor" на цю таблицю (розшарити таблицю на email сервісного акаунту).
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
